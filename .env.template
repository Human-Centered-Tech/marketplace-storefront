MEDUSA_BACKEND_URL=http://localhost:9000
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_REGION=pl
NEXT_PUBLIC_STRIPE_KEY=supersecret
REVALIDATE_SECRET=supersecret
NEXT_PUBLIC_SITE_NAME="Catholic Owned®"
NEXT_PUBLIC_SITE_DESCRIPTION="A Catholic marketplace and business directory supporting Catholic-owned businesses"
NEXT_PUBLIC_ALGOLIA_ID=supersecret
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=supersecret
NEXT_PUBLIC_VENDOR_URL=http://localhost:5174
# Google Maps browser key (referrer-restricted; Maps JavaScript API + Geocoding API).
# Renders the directory maps and geocodes the zip-search box.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Maps Map ID — required for Advanced Markers on the directory map.
# Create one in Cloud Console → Google Maps Platform → Map Management.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Google Analytics 4 measurement id (e.g. "G-XXXXXXX"). Leave empty to disable:
# GA (gtag.js) only loads when this is set, so it's safe to deploy dormant.
NEXT_PUBLIC_GA_ID=
# Set to "true" to force the EU cookie banner to show regardless of detected
# region. Detection is time-zone based, so this is the only practical way to QA
# the banner from the US. Never set it in production.
NEXT_PUBLIC_CONSENT_FORCE_BANNER=
# Shared secret for forwarding the real visitor IP to the backend on claim and
# vendor-signup calls, which are server ACTIONS (so the backend otherwise sees
# this server's IP for every visitor). Must MATCH the backend's
# CLAIM_IP_FORWARD_SECRET; unset on either side = no forwarding, no per-visitor
# claim-spread cap. See src/lib/data/client-ip.ts.
CLAIM_IP_FORWARD_SECRET=
